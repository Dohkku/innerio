# Self-host environment for the Innerio stack.
# Copy this file to `.env`, fill in secrets, then `docker compose up -d`.
#
# Generate hex secrets with: openssl rand -hex 32
# (Windows PowerShell: -join ((1..32) | %{ '{0:X2}' -f (Get-Random -Max 256) }))

# ----- Triplit sync server (always required) ------------------------------

# JWT secret used to sign per-user Triplit session tokens. 32+ bytes hex.
TRIPLIT_JWT_SECRET=change-me-to-a-32-byte-hex

# Project id stamped on every JWT — pick anything stable, only matters
# if you run multiple isolated Triplit projects on one server.
TRIPLIT_PROJECT_ID=gtd-self-hosted

# Host port the Triplit server binds to.
TRIPLIT_PORT=6543

# 1 = verbose Triplit logs (collection rules, sync events). Useful when
# debugging a fresh deploy; noisy in production.
TRIPLIT_VERBOSE=0

# ----- Better Auth (required: web sign-in won't work without these) -------

# Better Auth's session-signing secret. 32+ bytes hex.
BETTER_AUTH_SECRET=change-me-to-a-32-byte-hex

# Public origin of the web app — magic links and OAuth redirects build
# off this. In dev: http://localhost:5173. In prod: https://gtd.example.com.
WEB_ORIGIN=http://localhost:5173

# Auth server's own public origin. Defaults to WEB_ORIGIN; only override if
# the auth server is exposed on a different hostname than the web app.
# AUTH_BASE_URL=https://auth.example.com

# Path of the Better Auth SQLite file inside the container.
# AUTH_DB_PATH=./auth.sqlite

# Triplit JWT TTL (default 15m). Format: "1h", "24h", "30m".
# Short TTL reduces the replay window if a token leaks via WS query string
# logs. The web app calls /api/auth/triplit-token on every page load, so a
# short TTL has no UX cost.
# TRIPLIT_TOKEN_TTL=15m

# ----- Magic-link email via SMTP (optional) -------------------------------
# Without all three of HOST/USER/PASS, magic-link URLs print to the server
# stdout (dev mode) and no email is sent. Tested with Hostinger SMTP — any
# standard SMTP provider works (port 465 implies SSL, anything else uses
# STARTTLS automatically).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=you@your-domain.tld
# SMTP_PASS=your-mailbox-password
# SMTP_FROM="Innerio <no-reply@your-domain.tld>"

# ----- Google OAuth (optional) --------------------------------------------
# Without these, the Google button is hidden in /login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ----- Postgres (Phase 2+, only with --profile postgres) ------------------
# Currently unused — Better Auth lives on bun:sqlite. Kept for future use
# (Postgres-backed auth, audit log, etc.) so docker compose --profile
# postgres still works for users who want a relational add-on.
POSTGRES_USER=gtd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gtd
POSTGRES_PORT=5432

# ----- Caddy TLS reverse proxy (optional, --profile caddy) ----------------
# Only needed if you're NOT fronting via Cloudflare tunnel and want Caddy
# to handle Let's Encrypt. Rename Caddyfile.example to Caddyfile first.
# DOMAIN=gtd.example.com
# EMAIL=you@example.com
