# Copia este archivo a `keystore.properties` (gitignored) y rellena con los
# datos de tu upload keystore. NO commitees keystore.properties ni el .jks.
#
# Crear el keystore (una vez):
#   keytool -genkey -v -keystore innerio-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias innerio
#
# storeFile es relativo a apps/mobile/android/ (deja el .jks fuera del repo).
storeFile=../../../innerio-upload.jks
storePassword=CHANGEME
keyAlias=innerio
keyPassword=CHANGEME
