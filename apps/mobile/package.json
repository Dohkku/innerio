{
  "name": "@gtd/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Cáscara Capacitor (Android) de Innerio. La UI vive en apps/web; aquí solo config nativa + bridge de notificaciones.",
  "scripts": {
    "copy": "cap copy android",
    "sync": "cap sync android",
    "open": "cap open android",
    "build:web": "cd ../web && bun run build",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "aab:release": "cd android && ./gradlew bundleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.6.0"
  }
}
